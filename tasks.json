{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Anno XML Viewer EXE",
            "type": "shell",
            "command": "pyinstaller",
            "args": [
                "--onefile",
                "--windowed",
                "--icon",
                "data/ui/AnnoXMLTool.ico",
                "--name",
                "AnnoXMLViewer",
                "--add-data",
                "data/ui/kofi5.webp;data/ui",
                "--add-data",
                "version.txt;.",
                "--add-data",
                "data/ui/AnnoXMLTool.ico;data/ui",
                "Anno_XML_Tool.py"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}
